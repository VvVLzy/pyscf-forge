    return f'He {r1} {r1} {r1}; He {r1+r} {r1} {r1}'

def make_cell(r, cutoff):
    return pgto.M(
        atom        = make_atom(r),
        basis       = basis,
        verbose     = verbose,
        a           = a,
        ke_cutoff   = cutoff,
        precision   = precision
    )

def run_exact(r, cutoff=ke_cutoff_exact):
    mf = pscf.RKS(make_cell(r, cutoff))
    mf.init_guess = init_guess
    mf.xc = xc
    mf.kernel()
    return mf

def run_paw(r):
    mf = pscf.RKS(make_cell(r, ke_cutoff))
    mf.init_guess = init_guess
    mf.xc = xc
    mydf = PAW.from_mf(mf, PWAccuracy=1e-8, alpha0=alpha0, augRadius=Rb, gdfNuc=gdfNuc,
                       nucCoreExp=nucCoreExp).build()
    mf.with_df = mydf
    mf._numint = PAWNumInt(mydf, mf)
    mf.kernel()
    return mf

def exact_cutoff_convergence(rscale=rscales[0], cutoffs=(1000, 1500, 2000, 2500, 3000)):
