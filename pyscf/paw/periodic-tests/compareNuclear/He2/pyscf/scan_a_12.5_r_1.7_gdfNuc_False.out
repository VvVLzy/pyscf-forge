        atom        = make_atom(r),
        basis       = basis,
        verbose     = verbose,
        a           = a,
        ke_cutoff   = cutoff,
        precision   = precision
    )

def run_exact(r, cutoff=ke_cutoff_exact):
    mf = pscf.RKS(make_cell(r, cutoff))
    mf.init_guess = init_guess
    mf.xc = xc
    mf.kernel()
