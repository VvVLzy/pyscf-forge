ke_cutoff_exact = 2000           # Ha; exact all-electron FFTDF reference
precision = 1e-8
alpha0 = 12.5                    # CP2K ALPHA0_HARD 12.5
Rb = 1.7                         # bohr; CP2K HARD_EXP_RADIUS 1.7
gdfNuc = True                    # nuclear attraction via GDF instead of the PAW nuclear terms
