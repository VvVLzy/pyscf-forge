    mf.init_guess = init_guess
    mf.xc = xc
    mydf = PAW.from_mf(mf, PWAccuracy=1e-8, alpha0=alpha0, augRadius=Rb, gdfNuc=gdfNuc).build()
    mf.with_df = mydf
