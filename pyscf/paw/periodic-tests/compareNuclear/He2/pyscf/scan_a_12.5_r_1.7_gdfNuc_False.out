        precision   = precision
    )

def run_exact(r, cutoff=ke_cutoff_exact):
    mf = pscf.RKS(make_cell(r, cutoff))
    mf.init_guess = init_guess
    mf.xc = xc
    mf.kernel()
    return mf

def run_paw(r):
