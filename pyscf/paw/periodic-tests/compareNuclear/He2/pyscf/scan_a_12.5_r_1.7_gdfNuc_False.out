    mf.kernel()
    return mf

def exact_cutoff_convergence(rscale=rscales[0], cutoffs=(1000, 1500, 2000, 2500, 3000)):
    '''Check the FFTDF reference converges with ke_cutoff (shortest bond is hardest).'''
    r = r0 * rscale
