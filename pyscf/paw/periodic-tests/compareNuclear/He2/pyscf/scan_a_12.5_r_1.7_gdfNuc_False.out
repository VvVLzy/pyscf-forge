        writer.writeheader()
        writer.writerows(results)

def exact_paw_diff(tag=''):
    results = []
    for rscale in rscales:
        r = r0 * rscale
        mf_exact = run_exact(r)
        mf_paw = run_paw(r)

        results.append({
            "r": r,
            "etot_exact": mf_exact.e_tot,
            "etot_paw": mf_paw.e_tot,
            "conv_exact": mf_exact.converged,
            "conv_paw": mf_paw.converged
        })

        # CLEANUP
