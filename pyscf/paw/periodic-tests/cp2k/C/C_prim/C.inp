&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME C
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &PRINT
    &TOTAL_NUMBERS ON
    &END TOTAL_NUMBERS
  &END PRINT
  &SUBSYS
    &CELL
      A	2.18050236	0.0	1.25891346
      B	0.72683412	2.05579703	1.25891346
      C	-0.0	0.0	2.51782692
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME C.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND C
      POTENTIAL ALL
      BASIS_SET CC-PVDZ
      HARD_EXP_RADIUS 1.2
    &END KIND
  &END SUBSYS
  &DFT
    POTENTIAL_FILE_NAME POTENTIAL
    BASIS_SET_FILE_NAME CCPVxZ
    &MGRID
      NGRIDS 1
      CUTOFF 400
    &END MGRID
    &QS
      METHOD GAPW
      GAPW_1C_BASIS ORB
      EPS_DEFAULT 1.0E-10
      EPSFIT 1.0E-8
      EPS_CPC 1.0E-10
      EPS_ISO 1.0E-8
      ALPHA0_HARD 12.5 # might have factor of 2 difference with ours, No! just use high pw cutoff this is grid artifact
      !MAX_RAD_LOCAL 1.5
      !LMAXN0 4
    &END QS
    &XC
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
    &SCF
      IGNORE_CONVERGENCE_FAILURE TRUE
      EPS_SCF 1e-07
      MAX_SCF 50
      SCF_GUESS CORE
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &PRINT
      &GAPW
        &RHO0_INFORMATION ON
        &END RHO0_INFORMATION
        &PROJECTORS ON
        &END PROJECTORS
      &END GAPW
      &MO ON
        EIGENVECTORS T
        OCCUPATION_NUMBERS T
      &END MO
    &END PRINT
  &END DFT
&END FORCE_EVAL
