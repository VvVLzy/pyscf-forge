&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME He2
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &PRINT
    &TOTAL_NUMBERS ON
    &END TOTAL_NUMBERS
  &END PRINT
  &SUBSYS
    &CELL
      ABC 3.0 3.0 3.0          # 5 Angstrom cubic cell
      PERIODIC XYZ             # Re-affirm periodic calculation for the cell
    &END CELL
    &COORD
      ! Coordinates for a single Helium atom
      He   0.00000000   0.00000000   0.00000000
      He   1.0   0.00000000   0.00000000
    &END COORD
    &KIND He
      POTENTIAL ALL
      BASIS_SET mod-CC-PVTZ
      HARD_EXP_RADIUS 1.2
    &END KIND
  &END SUBSYS
  &DFT
    POTENTIAL_FILE_NAME /home/lebox/sw/cp2k/data/POTENTIAL
    BASIS_SET_FILE_NAME CCPVxZ
    &MGRID
      NGRIDS 1
      CUTOFF 400
    &END MGRID
    &QS
      METHOD GAPW
      GAPW_1C_BASIS ORB
      EPS_DEFAULT 1.0E-10
      EPSFIT 1.0E-8
      EPS_CPC 1.0E-10
      EPS_ISO 1.0E-8
      EPS_PGF_ORB 1.0E-8
      ALPHA0_HARD 12.5 # might have factor of 2 difference with ours, No! just use high pw cutoff this is grid artifact
      !MAX_RAD_LOCAL 1.5
      !LMAXN0 4
    &END QS
    &XC
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
    &SCF
      EPS_SCF 1e-07
      MAX_SCF 20
      IGNORE_CONVERGENCE_FAILURE T
      SCF_GUESS CORE
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &PRINT
      &GAPW
        &RHO0_INFORMATION ON
        &END RHO0_INFORMATION
        &PROJECTORS ON
        &END PROJECTORS
      &END GAPW
      &MO ON
        EIGENVECTORS T
        OCCUPATION_NUMBERS T
      &END MO
      &AO_MATRICES ON
        OCE_HARD T
        OCE_SOFT T
        DENSITY F
        OVERLAP T
        CORE_HAMILTONIAN T
        KOHN_SHAM_MATRIX T
        NDIGITS 13
      &END AO_MATRICES
      &MO_MOLDEN ON
        NDIGITS 8
        FILENAME =He2-MO.molden
      &END MO_MOLDEN
    &END PRINT
  &END DFT
&END FORCE_EVAL
